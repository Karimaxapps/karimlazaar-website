# MySQL connection (dev default points at the karimax-mysql Docker container on port 3321)
DATABASE_URL="mysql://root:password@localhost:3321/karimax_site"
# Password used to sign in at /admin/login
ADMIN_PASSWORD="choose-a-strong-password"
# Random hex string used to sign the admin session cookie
ADMIN_SECRET="generate-a-long-random-string"
SITE_URL="http://localhost:3000"
